// Prisma schema for clozr. Store, Product, Variant, Score, Suggestion, PublishLog.
// Shopify-first; keep IDs/timestamps and storeId relations for future platforms.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  installedAt DateTime? // when OAuth completed
  platform    String    // e.g. "shopify"
  shop        String    // shop domain (e.g. mystore.myshopify.com)
  accessToken String?
  products    Product[]
  scores      Score[]
  publishLogs PublishLog[]

  @@unique([platform, shop])
}

model Product {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalId      String?  // platform product id (e.g. Shopify product id)
  title           String?
  bodyHtml        String?
  handle          String?
  vendor          String?
  status          String?
  descriptionText String? // plain text from body_html
  imageUrls       Json?   // string[]
  rawJson         Json?   // raw API payload (optional)
  normalizedJson  Json?   // CPS snapshot
  variants        Variant[]
  scores          Score[]
  suggestions     Suggestion[]

  @@unique([storeId, externalId])
}

model Variant {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  externalId  String?  // platform variant id
  title       String?
  sku         String?
  price       Float?
  inventoryQty Int?
  optionsJson Json?    // e.g. ["Size", "Color"] or option1/2/3 values

  @@unique([productId, externalId])
}

model Score {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  value            Float?   // legacy; prefer overall
  overall          Float
  coverage         Float
  consistency      Float
  structure        Float
  eligibleSearch   Boolean
  eligibleCheckout Boolean
  blockersJson     Json?    // string[]
  warningsJson     Json?    // string[]
  reasonsJson      Json?    // string[]
  signalsJson      Json?    // Record<string, unknown>

  @@unique([productId])
}

model Suggestion {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  field       String   // e.g. "title", "description"
  suggestedValue String?
  publishLogs PublishLog[]
}

model PublishLog {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  suggestionId String
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  success      Boolean
  message      String?
}
